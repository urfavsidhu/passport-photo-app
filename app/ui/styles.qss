/* ==========================================================================
   Passport Photo App — Minimalist Glassmorphism SaaS Dashboard Theme
   ========================================================================== */

QWidget {
    font-family: "Segoe UI", "Arial", sans-serif;
    font-size: 13px;
    color: #F8FAFC;
    background-color: transparent;
}

QMainWindow, QDialog, QWizard {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:1, stop:0 #080C14, stop:0.4 #0E1524, stop:1 #0A111F);
}

/* --------------- Top Action Buttons & General Buttons --------------- */

QPushButton {
    background-color: rgba(255, 255, 255, 0.06);
    color: #F8FAFC;
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-top: 1px solid rgba(255, 255, 255, 0.16);
    border-radius: 9px;
    padding: 8px 16px;
    font-size: 13px;
    font-weight: 600;
    min-height: 38px;
}

QPushButton:hover {
    background-color: rgba(255, 255, 255, 0.11);
    border-color: #38BDF8;
}

QPushButton:pressed {
    background-color: rgba(255, 255, 255, 0.03);
}

QPushButton:checked {
    background-color: #38BDF8;
    color: #FFFFFF;
    border-color: #38BDF8;
    font-weight: bold;
}

QPushButton:disabled {
    background-color: rgba(255, 255, 255, 0.04);
    border-color: rgba(255, 255, 255, 0.06);
    color: #475569;
}

/* Primary Big Actions (Luminous SaaS CTAs) */
QPushButton#processBtn {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0, stop:0 #10B981, stop:1 #059669);
    color: #FFFFFF;
    font-size: 15px;
    font-weight: 700;
    min-height: 48px;
    padding: 10px 24px;
    border: none;
    border-radius: 10px;
}
QPushButton#processBtn:hover {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0, stop:0 #34D399, stop:1 #10B981);
}
QPushButton#processBtn:disabled {
    background-color: rgba(255, 255, 255, 0.04);
    color: #475569;
    border: 1px solid rgba(255, 255, 255, 0.06);
}

QPushButton#printBtn {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0, stop:0 #10B981, stop:1 #059669);
    color: #FFFFFF;
    font-size: 15px;
    font-weight: 700;
    min-height: 48px;
    padding: 10px 24px;
    border: none;
    border-radius: 10px;
}
QPushButton#printBtn:hover {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0, stop:0 #34D399, stop:1 #10B981);
}
QPushButton#printBtn:disabled {
    background-color: rgba(255, 255, 255, 0.04);
    color: #475569;
    border: 1px solid rgba(255, 255, 255, 0.06);
}

QPushButton#saveBtn {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0, stop:0 #2563EB, stop:1 #3B82F6);
    color: #FFFFFF;
    font-size: 14px;
    font-weight: 700;
    min-height: 44px;
    padding: 10px 22px;
    border: none;
    border-radius: 10px;
}
QPushButton#saveBtn:hover {
    background-color: #1D4ED8;
}
QPushButton#saveBtn:disabled {
    background-color: rgba(255, 255, 255, 0.04);
    color: #475569;
    border: 1px solid rgba(255, 255, 255, 0.06);
}

QPushButton[role="danger"] {
    background-color: rgba(255, 255, 255, 0.06);
    color: #EF4444;
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 8px;
    padding: 6px 14px;
    font-size: 12px;
    font-weight: 600;
    min-height: 34px;
}
QPushButton[role="danger"]:hover {
    background-color: #EF4444;
    color: #FFFFFF;
    border-color: #EF4444;
}

/* Floating Alert Banners (SaaS Pill Notice) */
QFrame#bannerFrame {
    background-color: rgba(239, 68, 68, 0.14);
    border: 1.5px solid rgba(239, 68, 68, 0.45);
    border-radius: 10px;
}
QLabel#bannerLabel {
    color: #FCA5A5;
    font-weight: bold;
    font-size: 13px;
}

QFrame#warnFrame {
    background-color: rgba(245, 158, 11, 0.14);
    border: 1.5px solid rgba(245, 158, 11, 0.45);
    border-radius: 10px;
}
QLabel#warnLabel {
    color: #FCD34D;
    font-weight: bold;
    font-size: 13px;
}

QLabel {
    color: #F8FAFC;
    font-size: 13px;
    padding: 2px;
}
QLabel#statusLabel {
    font-size: 12px;
    color: #94A3B8;
    padding: 4px 6px;
    background-color: transparent;
}
QLabel#previewPlaceholder {
    color: #94A3B8;
    font-size: 14px;
    background-color: rgba(20, 28, 44, 0.72);
    border: 1.5px dashed rgba(255, 255, 255, 0.16);
    border-radius: 14px;
}

/* Bento Grid Cards (Frosted Glass with Specular Edge) */
QGroupBox {
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.6px;
    color: #38BDF8;
    background-color: rgba(20, 28, 44, 0.72);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-top: 1px solid rgba(255, 255, 255, 0.16);
    border-radius: 14px;
    margin-top: 14px;
    padding: 16px 14px 14px 14px;
}
QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    margin-left: 10px;
    padding: 2px 10px;
    background-color: rgba(56, 189, 248, 0.10);
    border: 1px solid rgba(56, 189, 248, 0.22);
    border-radius: 6px;
    color: #38BDF8;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.5px;
}

/* Glass Inputs & Dropdowns */
QComboBox, QSpinBox, QDoubleSpinBox, QLineEdit {
    background-color: rgba(13, 19, 31, 0.72);
    border: 1px solid rgba(255, 255, 255, 0.09);
    border-radius: 8px;
    padding: 6px 12px;
    font-size: 13px;
    min-height: 36px;
    color: #F8FAFC;
}
QComboBox:hover, QSpinBox:hover, QDoubleSpinBox:hover, QLineEdit:hover {
    border-color: #38BDF8;
}
QComboBox:focus, QSpinBox:focus, QDoubleSpinBox:focus, QLineEdit:focus {
    border: 1.5px solid #38BDF8;
}
QComboBox::drop-down {
    border: none;
    width: 24px;
}
QComboBox QAbstractItemView {
    background-color: #131A29;
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 8px;
    padding: 4px;
    selection-background-color: rgba(56, 189, 248, 0.10);
    selection-color: #38BDF8;
    color: #F8FAFC;
}

/* Minimalist SaaS Sliders */
QSlider::groove:horizontal {
    height: 5px;
    background: rgba(255, 255, 255, 0.10);
    border-radius: 2.5px;
}
QSlider::sub-page:horizontal {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0, stop:0 #0284C7, stop:1 #38BDF8);
    border-radius: 2.5px;
}
QSlider::handle:horizontal {
    background: #FFFFFF;
    border: 2px solid #0284C7;
    width: 16px;
    height: 16px;
    margin: -5.5px 0;
    border-radius: 8px;
}
QSlider::handle:horizontal:hover {
    background: #38BDF8;
    border-color: #FFFFFF;
}

/* Progress Bar */
QProgressBar {
    background-color: rgba(20, 28, 44, 0.72);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 8px;
    height: 18px;
    text-align: center;
    font-size: 11px;
    color: #F8FAFC;
}
QProgressBar::chunk {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0, stop:0 #0284C7, stop:1 #38BDF8);
    border-radius: 7px;
}

/* Top Menu Bar */
QMenuBar {
    background-color: transparent;
    border: none;
    padding: 4px;
    font-size: 13px;
    color: #94A3B8;
}
QMenuBar::item {
    padding: 6px 12px;
    border-radius: 6px;
    background-color: transparent;
    color: #F8FAFC;
}
QMenuBar::item:selected {
    background-color: rgba(255, 255, 255, 0.06);
    color: #38BDF8;
}
QMenu {
    background-color: #131A29;
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 10px;
    padding: 6px;
}
QMenu::item {
    padding: 8px 24px;
    border-radius: 6px;
    color: #F8FAFC;
}
QMenu::item:selected {
    background-color: rgba(255, 255, 255, 0.06);
    color: #38BDF8;
}

/* Tooltips */
QToolTip {
    background-color: #131A29;
    color: #F8FAFC;
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 6px;
    padding: 6px 10px;
    font-size: 12px;
}

/* Scroll Area */
QScrollArea {
    border: none;
    background-color: transparent;
}
QScrollBar:vertical {
    background: transparent;
    width: 8px;
    border-radius: 4px;
    margin: 0;
}
QScrollBar::handle:vertical {
    background: rgba(255, 255, 255, 0.16);
    border-radius: 4px;
    min-height: 30px;
}
QScrollBar::handle:vertical:hover {
    background: #38BDF8;
}
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    height: 0px;
}

/* Status Bar */
QStatusBar {
    background-color: rgba(20, 28, 44, 0.72);
    border-top: 1px solid rgba(255, 255, 255, 0.08);
    font-size: 12px;
    color: #94A3B8;
    padding: 4px 12px;
}

/* Checkbox */
QCheckBox {
    font-size: 13px;
    spacing: 8px;
    padding: 4px;
    color: #F8FAFC;
}
QCheckBox::indicator {
    width: 18px;
    height: 18px;
    border: 1px solid rgba(255, 255, 255, 0.09);
    border-radius: 5px;
    background-color: rgba(13, 19, 31, 0.72);
}
QCheckBox::indicator:checked {
    background-color: #38BDF8;
    border-color: #38BDF8;
}
QCheckBox::indicator:hover {
    border-color: #38BDF8;
}

QFrame#colorPreview {
    border: 1.5px solid rgba(255, 255, 255, 0.16);
    border-radius: 8px;
    min-width: 50px;
    min-height: 36px;
}
