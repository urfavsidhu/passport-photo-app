/* Passport Photo App — Modern Light Theme */

QWidget {
    font-family: "Segoe UI", "Arial", sans-serif;
    font-size: 10pt;
    color: #1E293B;
}

QMainWindow, QDialog, QWizard {
    background-color: #F8FAFC;
}

/* --------------- Buttons --------------- */

QPushButton {
    background-color: #2563EB;
    color: white;
    border: none;
    border-radius: 8px;
    padding: 10px 24px;
    font-size: 14px;
    font-weight: bold;
    min-height: 44px;
}

QPushButton:hover {
    background-color: #1D4ED8;
}

QPushButton:pressed {
    background-color: #1E40AF;
}

QPushButton:disabled {
    background-color: #94A3B8;
    color: #CBD5E1;
}

QPushButton#processBtn {
    background-color: #16A34A;
    font-size: 18px;
    min-height: 52px;
    padding: 12px 32px;
}

QPushButton#processBtn:hover {
    background-color: #15803D;
}

QPushButton#printBtn {
    background-color: #DC2626;
    font-size: 18px;
    min-height: 52px;
    padding: 12px 32px;
}

QPushButton#printBtn:hover {
    background-color: #B91C1C;
}

QPushButton#saveBtn {
    background-color: #7C3AED;
    font-size: 15px;
    min-height: 48px;
}

QPushButton#saveBtn:hover {
    background-color: #6D28D9;
}

QPushButton#uploadBtn, QPushButton#cameraBtn {
    background-color: #0891B2;
    font-size: 16px;
    min-height: 52px;
    padding: 12px 24px;
}

QPushButton#uploadBtn:hover, QPushButton#cameraBtn:hover {
    background-color: #0E7490;
}

/* --------------- Labels --------------- */

QLabel {
    color: #334155;
    font-size: 14px;
    padding: 2px;
}

QLabel#titleLabel {
    font-size: 22px;
    font-weight: bold;
    color: #0F172A;
    padding: 8px 0px;
}

QLabel#statusLabel {
    font-size: 13px;
    color: #64748B;
    padding: 4px 8px;
    background-color: #F1F5F9;
    border-radius: 4px;
}

QLabel#previewPlaceholder {
    color: #94A3B8;
    font-size: 16px;
    font-style: italic;
}

/* --------------- Combo boxes --------------- */

QComboBox {
    background-color: white;
    border: 2px solid #CBD5E1;
    border-radius: 6px;
    padding: 8px 12px;
    font-size: 14px;
    min-height: 36px;
}

QComboBox:hover {
    border-color: #2563EB;
}

QComboBox:focus {
    border-color: #2563EB;
    outline: none;
}

QComboBox::drop-down {
    border: none;
    width: 30px;
}

QComboBox::down-arrow {
    width: 12px;
    height: 12px;
}

QComboBox QAbstractItemView {
    background-color: white;
    border: 2px solid #CBD5E1;
    border-radius: 4px;
    padding: 4px;
    selection-background-color: #DBEAFE;
    selection-color: #1E40AF;
}

/* --------------- Spin boxes --------------- */

QSpinBox, QDoubleSpinBox {
    background-color: white;
    border: 2px solid #CBD5E1;
    border-radius: 6px;
    padding: 8px 12px;
    font-size: 14px;
    min-height: 36px;
}

QSpinBox:hover, QDoubleSpinBox:hover {
    border-color: #2563EB;
}

/* --------------- Sliders --------------- */

QSlider::groove:horizontal {
    height: 8px;
    background: #E2E8F0;
    border-radius: 4px;
}

QSlider::handle:horizontal {
    background: #2563EB;
    border: 2px solid #1D4ED8;
    width: 20px;
    height: 20px;
    margin: -7px 0;
    border-radius: 11px;
}

QSlider::handle:horizontal:hover {
    background: #1D4ED8;
}

QSlider::sub-page:horizontal {
    background: #93C5FD;
    border-radius: 4px;
}

/* --------------- Progress bar --------------- */

QProgressBar {
    background-color: #E2E8F0;
    border: none;
    border-radius: 8px;
    height: 20px;
    text-align: center;
    font-size: 12px;
    color: #334155;
}

QProgressBar::chunk {
    background-color: #2563EB;
    border-radius: 8px;
}

/* --------------- Group boxes --------------- */

QGroupBox {
    font-size: 15px;
    font-weight: bold;
    color: #1E293B;
    border: 2px solid #E2E8F0;
    border-radius: 8px;
    margin-top: 12px;
    padding: 16px 12px 12px 12px;
}

QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    padding: 2px 12px;
    background-color: #F8FAFC;
    border-radius: 4px;
}

/* --------------- Menu bar --------------- */

QMenuBar {
    background-color: #FFFFFF;
    border-bottom: 1px solid #E2E8F0;
    padding: 4px;
    font-size: 14px;
}

QMenuBar::item {
    padding: 6px 12px;
    border-radius: 4px;
}

QMenuBar::item:selected {
    background-color: #DBEAFE;
}

QMenu {
    background-color: white;
    border: 1px solid #E2E8F0;
    border-radius: 8px;
    padding: 4px;
}

QMenu::item {
    padding: 8px 24px;
    border-radius: 4px;
}

QMenu::item:selected {
    background-color: #DBEAFE;
    color: #1E40AF;
}

/* --------------- Tooltips --------------- */

QToolTip {
    background-color: #1E293B;
    color: white;
    border: none;
    border-radius: 4px;
    padding: 6px 10px;
    font-size: 13px;
}

/* --------------- Scroll area --------------- */

QScrollArea {
    border: none;
    background-color: transparent;
}

QScrollBar:vertical {
    background: #F1F5F9;
    width: 10px;
    border-radius: 5px;
}

QScrollBar::handle:vertical {
    background: #94A3B8;
    border-radius: 5px;
    min-height: 30px;
}

QScrollBar::handle:vertical:hover {
    background: #64748B;
}

QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    height: 0px;
}

/* --------------- Status bar --------------- */

QStatusBar {
    background-color: #F1F5F9;
    border-top: 1px solid #E2E8F0;
    font-size: 13px;
    color: #64748B;
    padding: 4px;
}

/* --------------- Tab widget --------------- */

QTabWidget::pane {
    border: 2px solid #E2E8F0;
    border-radius: 8px;
    background-color: white;
}

QTabBar::tab {
    background-color: #F1F5F9;
    border: 1px solid #E2E8F0;
    border-bottom: none;
    border-top-left-radius: 6px;
    border-top-right-radius: 6px;
    padding: 8px 20px;
    font-size: 14px;
    margin-right: 2px;
}

QTabBar::tab:selected {
    background-color: white;
    font-weight: bold;
    color: #2563EB;
}

QTabBar::tab:hover {
    background-color: #DBEAFE;
}

/* --------------- Check boxes --------------- */

QCheckBox {
    font-size: 14px;
    spacing: 8px;
    padding: 4px;
}

QCheckBox::indicator {
    width: 20px;
    height: 20px;
    border: 2px solid #CBD5E1;
    border-radius: 4px;
    background-color: white;
}

QCheckBox::indicator:checked {
    background-color: #2563EB;
    border-color: #2563EB;
}

QCheckBox::indicator:hover {
    border-color: #2563EB;
}

/* --------------- Line edits --------------- */

QLineEdit {
    background-color: white;
    border: 2px solid #CBD5E1;
    border-radius: 6px;
    padding: 8px 12px;
    font-size: 14px;
    min-height: 36px;
}

QLineEdit:focus {
    border-color: #2563EB;
}

/* --------------- Color preview --------------- */

QFrame#colorPreview {
    border: 2px solid #CBD5E1;
    border-radius: 8px;
    min-width: 60px;
    min-height: 60px;
}
