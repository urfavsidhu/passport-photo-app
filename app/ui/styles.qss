/* ==========================================================================
   Passport Photo App — Modern Dark Slate Theme (Matching User Reference)
   ========================================================================== */

QWidget {
    font-family: "Segoe UI", "Arial", sans-serif;
    font-size: 14px;
    color: #F1F5F9;
    background-color: transparent;
}

QMainWindow, QDialog, QWizard {
    background-color: #171E28;
}

/* --------------- Top Action Buttons & General Buttons --------------- */

QPushButton {
    background-color: #2D3748;
    color: #F1F5F9;
    border: 1px solid #3E4D64;
    border-radius: 8px;
    padding: 8px 16px;
    font-size: 14px;
    font-weight: 600;
    min-height: 40px;
}

QPushButton:hover {
    background-color: #374358;
    border-color: #4A5B75;
}

QPushButton:pressed {
    background-color: #242E3D;
}

QPushButton:checked {
    background-color: #38BDF8;
    color: #0F172A;
    border-color: #38BDF8;
    font-weight: bold;
}

QPushButton:disabled {
    background-color: #1A222D;
    border-color: #252F3F;
    color: #475569;
}

/* Primary Big Actions */
QPushButton#processBtn {
    background-color: #16A34A;
    color: #FFFFFF;
    font-size: 17px;
    font-weight: bold;
    min-height: 50px;
    padding: 12px 28px;
    border: none;
}
QPushButton#processBtn:hover {
    background-color: #15803D;
}

QPushButton#printBtn {
    background-color: #16A34A;
    color: #FFFFFF;
    font-size: 17px;
    font-weight: bold;
    min-height: 50px;
    padding: 12px 28px;
    border: none;
}
QPushButton#printBtn:hover {
    background-color: #15803D;
}

QPushButton#saveBtn {
    background-color: #2563EB;
    color: #FFFFFF;
    font-size: 15px;
    font-weight: bold;
    min-height: 44px;
    padding: 10px 24px;
    border: none;
}
QPushButton#saveBtn:hover {
    background-color: #1D4ED8;
}

QPushButton[role="danger"] {
    background-color: #2D3748;
    color: #EF4444;
    border: 1px solid #4A3337;
    border-radius: 8px;
    padding: 8px 16px;
    font-size: 14px;
    font-weight: 600;
    min-height: 38px;
}
QPushButton[role="danger"]:hover {
    background-color: #EF4444;
    color: #FFFFFF;
    border-color: #DC2626;
}

/* --------------- Quality & Defect Safety Banners --------------- */

QFrame#bannerFrame {
    background-color: #351518;
    border: 1.5px solid #EF4444;
    border-radius: 8px;
}

QLabel#bannerLabel {
    color: #FCA5A5;
    font-weight: bold;
    font-size: 14px;
}

QFrame#warnFrame {
    background-color: #332610;
    border: 1.5px solid #F59E0B;
    border-radius: 8px;
}

QLabel#warnLabel {
    color: #FCD34D;
    font-weight: bold;
    font-size: 14px;
}

/* --------------- Labels --------------- */

QLabel {
    color: #E2E8F0;
    font-size: 14px;
    padding: 2px;
}

QLabel#titleLabel {
    font-size: 22px;
    font-weight: bold;
    color: #F8FAFC;
    padding: 8px 0px;
}

QLabel#statusLabel {
    font-size: 13px;
    color: #94A3B8;
    padding: 4px 6px;
    background-color: transparent;
}

QLabel#previewPlaceholder {
    color: #8E9EB2;
    font-size: 15px;
    background-color: #1F2735;
    border: 1.5px dashed #344052;
    border-radius: 10px;
}

/* --------------- Group Boxes (Cards) --------------- */

QGroupBox {
    font-size: 14px;
    font-weight: bold;
    color: #F1F5F9;
    border: 1px solid #2D384A;
    border-radius: 10px;
    margin-top: 14px;
    padding: 16px 12px 12px 12px;
    background-color: #1F2735;
}

QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    padding: 1px 8px;
    background-color: #171E28;
    border: 1px solid #2D384A;
    border-radius: 4px;
    color: #F1F5F9;
}

/* --------------- Input Controls --------------- */

QComboBox, QSpinBox, QDoubleSpinBox, QLineEdit {
    background-color: #141A23;
    border: 1px solid #2B3648;
    border-radius: 6px;
    padding: 8px 12px;
    font-size: 14px;
    min-height: 38px;
    color: #F1F5F9;
}

QComboBox:hover, QSpinBox:hover, QDoubleSpinBox:hover, QLineEdit:hover {
    border-color: #3B4A62;
}

QComboBox:focus, QSpinBox:focus, QDoubleSpinBox:focus, QLineEdit:focus {
    border-color: #38BDF8;
}

QComboBox::drop-down {
    border: none;
    width: 28px;
}

QComboBox QAbstractItemView {
    background-color: #141A23;
    border: 1px solid #2B3648;
    border-radius: 6px;
    padding: 4px;
    selection-background-color: #243042;
    selection-color: #38BDF8;
    color: #F1F5F9;
}

/* --------------- Sliders (Cyan Bar & Slate Handle) --------------- */

QSlider::groove:horizontal {
    height: 6px;
    background: #283344;
    border-radius: 3px;
}

QSlider::sub-page:horizontal {
    background: #38BDF8;
    border-radius: 3px;
}

QSlider::handle:horizontal {
    background: #94A3B8;
    border: 2px solid #CBD5E1;
    width: 18px;
    height: 18px;
    margin: -6px 0;
    border-radius: 9px;
}

QSlider::handle:horizontal:hover {
    background: #F1F5F9;
    border-color: #38BDF8;
}

/* --------------- Progress Bar --------------- */

QProgressBar {
    background-color: #1F2735;
    border: 1px solid #2B3648;
    border-radius: 8px;
    height: 20px;
    text-align: center;
    font-size: 12px;
    color: #F1F5F9;
}

QProgressBar::chunk {
    background-color: #38BDF8;
    border-radius: 7px;
}

/* --------------- Menu Bar & Menus --------------- */

QMenuBar {
    background-color: #171E28;
    border: none;
    padding: 4px;
    font-size: 14px;
    color: #CBD5E1;
}

QMenuBar::item {
    padding: 6px 12px;
    border-radius: 4px;
    background-color: transparent;
    color: #CBD5E1;
}

QMenuBar::item:selected {
    background-color: #2B3648;
    color: #FFFFFF;
}

QMenu {
    background-color: #1E2634;
    border: 1px solid #2B3648;
    border-radius: 8px;
    padding: 4px;
}

QMenu::item {
    padding: 8px 24px;
    border-radius: 4px;
    color: #F1F5F9;
}

QMenu::item:selected {
    background-color: #2B3648;
    color: #38BDF8;
}

/* --------------- Tooltips --------------- */

QToolTip {
    background-color: #1E2634;
    color: #F1F5F9;
    border: 1px solid #2B3648;
    border-radius: 4px;
    padding: 6px 10px;
    font-size: 13px;
}

/* --------------- Scrollbars --------------- */

QScrollArea {
    border: none;
    background-color: transparent;
}

QScrollBar:vertical {
    background: #171E28;
    width: 10px;
    border-radius: 5px;
}

QScrollBar::handle:vertical {
    background: #2E3A4D;
    border-radius: 5px;
    min-height: 30px;
}

QScrollBar::handle:vertical:hover {
    background: #3B4A62;
}

QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    height: 0px;
}

/* --------------- Status Bar --------------- */

QStatusBar {
    background-color: #141A23;
    border-top: 1px solid #2B3648;
    font-size: 13px;
    color: #94A3B8;
    padding: 4px;
}

/* --------------- Checkboxes --------------- */

QCheckBox {
    font-size: 14px;
    spacing: 8px;
    padding: 4px;
    color: #E2E8F0;
}

QCheckBox::indicator {
    width: 18px;
    height: 18px;
    border: 1px solid #2B3648;
    border-radius: 4px;
    background-color: #141A23;
}

QCheckBox::indicator:checked {
    background-color: #38BDF8;
    border-color: #38BDF8;
}

QCheckBox::indicator:hover {
    border-color: #38BDF8;
}

/* --------------- Color Preview Frame --------------- */

QFrame#colorPreview {
    border: 1px solid #3E4D64;
    border-radius: 6px;
    min-width: 50px;
    min-height: 36px;
}
